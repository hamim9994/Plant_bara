# Copy to .env and adjust if your files live elsewhere.

# Trained Keras model loaded on startup.
MODEL_PATH=phase1_artifacts/best_model.keras

# Normalized reference data for the 38 PlantVillage classes.
DISEASE_INFO_PATH=phase1_artifacts/disease_info.json

# Maximum accepted upload size in bytes (10 MiB).
MAX_UPLOAD_BYTES=10485760

# Ordered 38-class label list and training metadata.
CLASS_NAMES_PATH=phase1_artifacts/class_names.json
MODEL_META_PATH=phase1_artifacts/model_meta.json

# Model input resolution (WIDTHxHEIGHT or WIDTH,HEIGHT).
INPUT_SIZE=224x224

# Accepted upload MIME types (comma-separated).
ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/bmp

# Comma-separated browser origins allowed by CORS; * allows all origins.
CORS_ORIGINS=*

# Number of predictions returned when top_k is omitted, and its upper bound.
DEFAULT_TOP_K=3
MAX_TOP_K=38
